  "purpose": "Create the smallest governed syllabification layer needed for multi-root Mix-Glifos while preserving existing B1-B6 phonology.",
  "source_facts": {
    "audited_forms": 33,
    "strict_cv_family_matches": 26,
    "exceptions": 7,
    "adjacent_vowels_allowed": true,
    "vvv_allowed": true,
    "adjacent_vowels_careful_default": "DISTINCT_VOWEL_NUCLEI",
    "productive_diphthongs": false,
    "automatic_y_to_j": false,
    "final_consonants_allowed": true,
    "ts_g30_atomic": true,
    "complete_syllable_template_grammar": false
  },
  "key_problem": "26/33 forms matching (CV)+(C)? is corpus evidence and an authoring preference, not yet authority that every C attaches to the following V or that final C is a coda. Multi-root Mix-Glifos require exactly that missing boundary authority.",
  "options": [
    {
      "id": "SYL1-OPTION-A",
      "decision": "CONSERVATIVE_MAXIMAL_ONSET_WITH_SINGLE_CONSONANT_ONLY",
      "recommended": true,
      "proposed_rules": [
        "Every governed vowel nucleus heads exactly one syllable in careful pronunciation.",
        "Adjacent vowels already governed as distinct nuclei therefore create distinct syllables unless a later explicit exception is approved.",
        "A single consonant between two vowel nuclei attaches to the following nucleus (V.CV).",
        "A word-initial consonant before a vowel is onset of that vowel.",
        "A word-final consonant after a vowel is coda of the final syllable.",
        "G30 /ts/ counts as one consonant for these rules.",
        "Internal clusters of two or more consonants remain unresolved case-by-case; do not split them automatically.",
        "BRIDGE forms do not induce native syllabification rules."
      ],
      "expected_effect": "Licenses deterministic syllabification for simple CV-rich native forms, final-C forms and adjacent-vowel nuclei without inventing cluster phonotactics."
    },
    {
      "id": "SYL1-OPTION-B",
      "decision": "CV_ONLY_BOUNDARY_AUTHORITY",
      "recommended": false,
      "proposed_rules": [
        "Approve only repeated CV boundaries in strict-profile forms; keep final consonants, vowel-initial forms and all exceptions unresolved."
      ],
      "expected_effect": "Safer but leaves many attested structures unavailable to Mix-Glifo composition."
    },
    {
      "id": "SYL1-OPTION-C",
      "decision": "KEEP_ALL_SYLLABLE_BOUNDARIES_LEXICAL",
      "recommended": false,
      "proposed_rules": [
        "No productive boundary algorithm; approve each lexeme manually."
      ],
      "expected_effect": "Maximum preservation but poor scalability for A1 and Mix-Glifo generation."
    }
  ],
  "recommended_decision": "SYL1-OPTION-A",
  "boundaries": {
    "no_new_phonemes": true,
    "no_new_diphthongs": true,
    "no_new_glide_rules": true,
    "no_stress_rule": true,

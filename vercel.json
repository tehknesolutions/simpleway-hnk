{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:a1-alpha",
  "outputDirectory": "dist/a1",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
